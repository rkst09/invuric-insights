# Copy this file to .env and fill in your values.
# Never commit .env; it is already in .gitignore.

# Anthropic
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase
# Project URL and keys from Settings > API in the Supabase dashboard.
# The service-role key bypasses Row Level Security; keep it secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# CORS / trusted hosts
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-app.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.onrender.com,*.vercel.app

# Auth
# Only these email domains may sign in (checked against the verified Supabase/Azure
# user's email on every request, independent of the profiles table). Comma-separated.
ALLOWED_EMAIL_DOMAINS=invuric.co

# DANGER: local testing only. Bypasses all authentication with a fake dev user so you
# can test the rest of the app before Microsoft sign-in is configured. main.py refuses
# to start with this on if ENVIRONMENT=production. Never set this in any deployed env.
# DEV_BYPASS_AUTH=true

# Runtime
# "development" disables HSTS; set to "production" on Render.
ENVIRONMENT=development
STORAGE_BACKEND=auto
PUBLIC_BACKEND_URL=http://localhost:8000
LIBREOFFICE_BINARY=C:\Program Files\LibreOffice\program\soffice.exe

# Optional overrides
# STORAGE_BACKEND=local                      # force local JSON/file storage when Supabase is unavailable
# MAX_FILE_SIZE_MB=50
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_UPLOADS_PER_WINDOW=12
# RATE_LIMIT_GENERATIONS_PER_WINDOW=24
# LLM_REQUEST_TIMEOUT_SECONDS=300
# GENERATION_MODEL_TIMEOUT_SECONDS=180
# DOCUMENT_MODEL_TIMEOUT_SECONDS=60
# RAID_MODEL_TIMEOUT_SECONDS=60
# BACKLOG_MODEL_TIMEOUT_SECONDS=60
# WBS_MODEL_TIMEOUT_SECONDS=60
# GENERATION_INPUT_MAX_CHARS=30000
# GENERATION_TEMPLATE_MAX_CHARS=8000
# LLM_JSON_MAX_TOKENS=16000
# LLM_TEXT_MAX_TOKENS=4000
# LLM_MAX_VALIDATION_REPAIRS=3
# Vision (Backlog/User Stories generation only) - lets Claude see uploaded screens
# and PDF pages directly instead of just their extracted text. Not redacted - the
# upload UI warns about this.
# BACKLOG_VISION_MAX_IMAGES=6
# BACKLOG_VISION_MAX_PDF_PAGES_EACH=6
# BACKLOG_VISION_MAX_IMAGE_DIMENSION=1568
# EXTERNAL_REQUEST_MAX_ATTEMPTS=3
# EXTERNAL_REQUEST_RETRY_DELAY_SECONDS=1.0
# LIBREOFFICE_BINARY=/usr/bin/libreoffice   # set on Render/Linux if LibreOffice is installed
