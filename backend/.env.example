# Copy this file to .env and fill in your values.
# Never commit .env — it is already in .gitignore.

# ── Anthropic ──────────────────────────────────────────────────────────────────
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL and keys from Settings → API in the Supabase dashboard.
# The service-role key bypasses Row Level Security — keep it secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── CORS / Trusted Hosts ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-app.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.onrender.com,*.vercel.app

# ── Environment ────────────────────────────────────────────────────────────────
# "development" disables HSTS; set to "production" on Render.
ENVIRONMENT=development

# ── Optional overrides (safe defaults shown) ──────────────────────────────────
# MAX_FILE_SIZE_MB=50
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_UPLOADS_PER_WINDOW=12
# RATE_LIMIT_GENERATIONS_PER_WINDOW=24
# LLM_REQUEST_TIMEOUT_SECONDS=300
# LLM_JSON_MAX_TOKENS=16000
# LLM_TEXT_MAX_TOKENS=4000
# LLM_MAX_VALIDATION_REPAIRS=3
# LIBREOFFICE_BINARY=/usr/bin/libreoffice   # set on Render if LibreOffice is installed
