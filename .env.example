# Copy this file to .env.local and fill in your values.
# Never commit .env.local; it is already in .gitignore.

VITE_API_URL=http://localhost:8000

# Supabase (used for sign-in only; the anon key is safe to expose client-side)
# Project URL and anon key from Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# DANGER: local testing only. Skips the login redirect so you can click through the
# app before Microsoft sign-in is configured. Pair with backend DEV_BYPASS_AUTH=true.
# Never set this in any deployed environment.
# VITE_DEV_BYPASS_AUTH=true
